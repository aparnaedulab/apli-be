# Checked out with LF everywhere, whatever the machine.
#
# Not cosmetic: a shell script committed from Windows arrives on the VM with
# CRLF line endings and dies as `bad interpreter: /usr/bin/env bash^M`, which
# DEPLOYMENT.md already lists as a thing that happens. Normalising here means
# it cannot.
* text=auto eol=lf

*.sh   text eol=lf
*.sql  text eol=lf

# Binary, and must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary
