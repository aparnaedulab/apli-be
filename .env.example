# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# --- MySQL ------------------------------------------------------------------
# These five ARE the database. The connection string is built from them in
# code, with the user and password escaped - so a password containing
# # @ : / or ? simply works, rather than cutting the URL in half and coming
# back as "the provided database credentials are not valid".
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=apli
MYSQL_PASSWORD=
MYSQL_DATABASE=apli

# Only for a connection the five fields cannot express: a managed host that
# hands you a whole URL, a socket path, TLS parameters. Blank means "compose
# it from the fields above", which is what you want. Set, it wins outright
# and the fields are ignored - so do not leave a stale one here.
DATABASE_URL=

# Session signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Where the React client runs, for CORS + cookies. In production this is the
# public address of the portal, e.g. http://203.0.113.10 or https://apli.example.com
CLIENT_ORIGIN=http://localhost:5180

# Whether the session cookie is marked `secure`. Blank follows NODE_ENV:
# secure in production, not in development. A browser drops a secure cookie
# sent over plain http, so a production portal served over http (a bare IP
# with no certificate yet) must set this to false or no one can log in.
# Set it back to true as soon as there is TLS.
COOKIE_SECURE=

# Super admin, created with: npm run create:admin
# Leave ADMIN_PASSWORD blank to have a strong one generated and printed once.
ADMIN_EMAIL=admin@apli.example
ADMIN_NAME=Super Admin
ADMIN_PASSWORD=

# The university this portal belongs to. Shown on the college form and in the
# bulk-upload template, and written to colleges marked as affiliated.
HOME_UNIVERSITY="Savitribai Phule Pune University"

# --- Sending email --------------------------------------------------------
# All optional. With none of this set the portal still runs, and every screen
# that offers to email an invitation says plainly that it cannot - links are
# then copied by hand, exactly as before.
#
# Either give a whole URL:
#   SMTP_URL=smtp://user:password@smtp.gmail.com:587
# or the pieces:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave blank for STARTTLS on 587; set true for implicit TLS on 465.
SMTP_SECURE=

# What recipients see in the From line, and who they can reply to.
MAIL_FROM="Apli.ai <no-reply@apli.example>"
MAIL_REPLY_TO=

# --- Serving the client ---------------------------------------------------
# Where the built client is, relative to this folder or absolute.
#
# Set it and Node serves the site and the API on ONE port, which is what you
# want on a bare IP with no nginx: the client fetches a relative /api, so on
# two ports it would ask the port it was served from and find nothing there.
# Leave it blank when nginx serves the bundle instead.
#
#   CLIENT_DIST=../client/dist
CLIENT_DIST=

# --- Uploads ----------------------------------------------------------------
# Where institution logos and favicons are stored. Relative to the server
# folder. Back it up with the database.
UPLOAD_DIR=uploads

# --- Mock interviews (optional) ---------------------------------------------
# With a key, students' mock-interview answers also get AI feedback from
# Claude. Leave blank and the built-in feedback is used - the feature works
# either way. Answers are sent as text only; no names or contact details.
ANTHROPIC_API_KEY=
# The Claude model that reviews answers. Blank means claude-opus-5.
MOCK_INTERVIEW_MODEL=

# --- WhatsApp (optional) ----------------------------------------------------
# Meta WhatsApp Cloud API. Leave blank and nothing is sent: each message is
# logged as "WhatsApp is not set up" on the college's Messages page.
# Messages go only to students whose institution has WhatsApp switched on,
# who have allowed WhatsApp updates on their Privacy page, and who have a
# valid Indian mobile number. Each in-app notification is copied at most once.
#
# Every template named below must be created AND approved in Meta Business
# Manager (WhatsApp Manager > Message templates) before it can be sent. Each
# takes two body parameters: {{1}} a short title, {{2}} the message.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The language the templates were approved in. Blank means en.
WHATSAPP_TEMPLATE_LANG=
# Graph API version. Blank means v21.0.
WHATSAPP_API_VERSION=
# Optional JSON overriding template names per notification type, e.g.
# {"application.offered":"apli_offer_made","SHOWCASE_INVITE":"apli_invite"}
WHATSAPP_TEMPLATES=
